<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8">
<title>{{ name }} · Job Application Handbook</title>
<style>
  {{ style }}
</style></head>
<body>

<h1>{{ name }} · Job Application Handbook</h1>
<div class="subtitle">Auto-filtered from full job listings · Clickable apply links</div>

<div class="summary">
  <div class="summary-grid">
    <div class="summary-item"><div class="num">{{ total_jobs }}</div><div class="label">Matched Jobs</div></div>
    {% for item in summary_cities %}
    <div class="summary-item"><div class="num">{{ item.count }}</div><div class="label">{{ item.emoji }} {{ item.city }}</div></div>
    {% endfor %}
  </div>
</div>

{% if highlights or search_keywords %}
<div class="keyword-box">
  {% if highlights %}<b>Resume Highlights:</b> {{ highlights }}<br>{% endif %}
  {% if search_keywords %}<b>Suggested Search Keywords:</b> {{ search_keywords }}{% endif %}
</div>
{% endif %}

{# City-grouped high-match jobs #}
{% for section in city_sections %}
<div class="section-title">{{ section.emoji }} {{ section.city }} · High Match Jobs ({{ section.jobs|length }})</div>
{% for card in section.jobs %}
{{ card }}
{% endfor %}
{% endfor %}

{# Campus jobs #}
{% if campus_section %}
<div class="section-title">&#127891; Campus / New Grad Jobs ({{ campus_section.jobs|length }})</div>
{% for card in campus_section.jobs %}
{{ card }}
{% endfor %}
{% endif %}

{# Strategy section #}
<div class="page-break"></div>
<div class="section-title">&#128203; Application Strategy &amp; Tips</div>

{% if strategy_text %}
{% for tip in strategy_text %}
<div class="strategy-card">{{ tip }}</div>
{% endfor %}
{% else %}
<div class="strategy-card"><b>Week 1:</b> Apply to all high-match positions</div>
<div class="strategy-card"><b>Week 2:</b> Follow up on applications + seek referrals</div>
<div class="strategy-card"><b>Week 3:</b> Focus on interview preparation for responding companies</div>
<div class="strategy-card"><b>Tip:</b> Always submit resume as PDF. Follow up within 24 hours if no response.</div>
{% endif %}

<div class="footer"><p>Generated by job-hunter (github.com/your/job-hunter) · All links are clickable</p></div>
</body></html>
